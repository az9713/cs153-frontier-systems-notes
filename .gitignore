# Publish only the reading site, authored chapters, and portable build tools.
/*
!/.gitignore
!/.nojekyll
!/README.md
!/requirements.txt
!/render_notes.py
!/validate_notes.py
!/index.html
!/sources.html
!/lecture-*.html
!/assets/
/assets/*
!/assets/style.css
!/assets/code-copy.js
!/assets/mathjax-tex-svg.js
!/assets/mathjax-LICENSE
!/assets/preview.png
!/chapters/
/chapters/*
!/chapters/lecture-*.md
!/labs/
/labs/*
!/labs/check_chapters.py
!/sources/
/sources/*
!/sources/manifest.json
!/sources/section-map.json
!/sources/reading-manifest.json
